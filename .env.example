# 개발용 PostgreSQL (현재 런타임은 TLS를 사용합니다)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/soopsori"
# 런타임/CLI 별도 연결이 필요한 경우에만 지정합니다.
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL=""
# POSTGRES_URL_NON_POOLING=""

# 로컬에서 생성한 임의의 비밀값을 입력합니다.
AUTH_SECRET=""

# 선택: 네이버 지도 및 주소 검색
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=""
NAVER_MAP_CLIENT_SECRET=""

# 선택: 이미지 업로드
BLOB_READ_WRITE_TOKEN=""
